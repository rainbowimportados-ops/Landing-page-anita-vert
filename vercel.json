{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "inc": [
              "instituto-vert-rainbowimportadosgmailcoms-projects.vercel.app",
              "instituto-vert-git-main-rainbowimportadosgmailcoms-projects.vercel.app",
              "instituto-vert-git-c-f3824f-rainbowimportadosgmailcoms-projects.vercel.app"
            ]
          }
        }
      ],
      "destination": "https://instituto-vert.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "vert.institutovert.app" }],
      "destination": "/agendar"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
